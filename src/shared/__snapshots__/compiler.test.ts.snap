exports[`layerCalls and codeFor snapshots > starter: code listing 1`] = `
"// 100 bpm in A minor. One cycle = one bar of 4 beats.
// Recorded sounds such as s("kick") are loaded with samples() from files published with this page.
setcpm(25)

stack(
  // Kick
  s("kick").struct("x(4,16)").lpf(6000).gain(0.629),
  // Snare
  s("snare").struct("~ x ~ x").lpf(6000).room(0.135).gain(0.42),
  // Hi-hats
  s("hihat").struct("[~ x]*4").cut(1).lpf(6000).gain(0.399),
  // Bass
  n("<0 0 5 3>").struct("x(3,8)").scale("A2:minor").s("ebass").release(0.12).lpf(4447).gain(1.488),
)"
`;

