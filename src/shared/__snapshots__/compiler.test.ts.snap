exports[`layerCalls and codeFor snapshots > synths: code listing 1`] = `
"// 128 bpm in F# dorian. One cycle = one bar of 4 beats.
// Recorded sounds such as s("trumpet") are loaded with samples() from files published with this page.
setcpm(32)

stack(
  // Kick
  s("sbd").struct("x(4,16)").decay(0.4).room(0.09).gain(1),
  // Hats (muted)
  // s("white").struct("[~ x]*4").hpf(8000).attack(0.001).decay(0.035).sustain(0).lpf(15720).room(0.09).gain(0.16),
  // Bass
  n("0 ~ 0 3").scale("F#1:dorian").s("sawtooth").attack(0.005).decay(0.18).sustain(0.5).release(0.08).lpf(994).room(0.09).gain(0.385),
  // Pad
  n("<[0,2,4] [3,5,7]>").scale("F#3:dorian").s("supersaw").attack(0.4).sustain(0.8).release(1.2).lpf(6000).room(0.72).gain(0.112),
  // Brass
  n("4 ~ 2 ~").struct("x(3,8,2)").scale("F#4:dorian").s("trumpet").release(0.15).lpf(7634).room(0.09).gain(1.872),
).swingBy(0.2, 8)"
`;
